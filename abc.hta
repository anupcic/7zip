<!DOCTYPE html>
<html>
<head>
<title>Local Test Loader</title>
<HTA:APPLICATION
    ID="TestLoader"
    APPLICATIONNAME="LocalTestLoader"
    BORDER="thin"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
    SCROLL="no" />
<style>
  body { font-family: Segoe UI, sans-serif; background:#1e1e1e; color:#ddd; padding:20px; }
  input[type=text] { width:520px; padding:6px; background:#2d2d2d; color:#eee; border:1px solid #444; }
  button { padding:6px 14px; background:#3a6ea5; color:#fff; border:0; cursor:pointer; }
  button:hover { background:#4a7eb5; }
  #log { margin-top:14px; height:180px; overflow:auto; background:#111; border:1px solid #333;
         padding:8px; font-family:Consolas,monospace; font-size:12px; white-space:pre-wrap; }
  .ok   { color:#7ec87e; }
  .err  { color:#e07a7a; }
  .info { color:#8ab4e8; }
  label { display:block; margin-top:10px; margin-bottom:4px; font-size:12px; color:#aaa; }
</style>
<script language="VBScript">
  ' VBScript is used only for MessageBox confirmation; logic lives in JS.'
</script>
<script language="JScript">

var shell = new ActiveXObject("WScript.Shell");
var fso   = new ActiveXObject("Scripting.FileSystemObject");

function log(msg, cls) {
    var box = document.getElementById("log");
    var span = document.createElement("span");
    if (cls) span.className = cls;
    span.innerText = msg + "\r\n";
    box.appendChild(span);
    box.scrollTop = box.scrollHeight;
}

function confirmRun(path) {
    // Simple modal via Shell.Popup so we don't depend on VBScript.
    var r = shell.Popup(
        "Downloaded to:\n" + path + "\n\nExecute this file now?",
        0, "Confirm Execution", 4 + 32  // Yes/No + Question icon
    );
    return (r === 6); // 6 = Yes
}

// function downloadAndMaybeRun() {
//     var url   = document.getElementById("url").value;
//     var fname = document.getElementById("fname").value;

//     if (!url || !fname) {
//         log("[!] URL and filename are required.", "err");
